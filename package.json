{
  "name": "@spyko/otel-bootstrap",
  "version": "0.1.1",
  "description": "Two-line OpenTelemetry + pino bootstrap for Node backends: OTLP traces and JSON logs with trace_id correlation baked in",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./register": {
      "import": {
        "types": "./dist/register.d.ts",
        "default": "./dist/register.js"
      },
      "require": {
        "types": "./dist/register.d.cts",
        "default": "./dist/register.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spykoninho/otel-bootstrap.git"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "opentelemetry",
    "otlp",
    "pino",
    "tracing",
    "observability",
    "trace-id",
    "correlation"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/register.ts --format esm,cjs --dts --clean",
    "lint": "eslint src test",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.221.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@spyko/eslint-config": "0.1.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
